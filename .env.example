DB_URL=jdbc:mysql://localhost:3306/language_learning
DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

SERVER_PORT=8080

# Origin của Frontend (Vite dev server) - dùng để cấu hình CORS allowCredentials cho cookie refresh token
FRONTEND_URL=http://localhost:5173
# true khi deploy qua HTTPS thật (bắt buộc true nếu SameSite=None ở production) - false cho dev local qua HTTP
COOKIE_SECURE=false
